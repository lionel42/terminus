# Enable development behavior for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="Terminus"

SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Allow public sign-up via /users/signup (superusers can always create users)
USERS_OPEN_REGISTRATION=false

# Emails
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# MySQL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# URL-encode special characters in the password (e.g. @ -> %40, / -> %2F, : -> %3A).
# For TLS, append ?ssl_ca=/path/to/ca.pem
# MySQL runs in its own container/server, not in this compose project.
DATABASE_URL=mysql://terminus:changethis@localhost:3308/terminus
# Same database, as seen from the backend running inside Docker (compose.override.yml)
DOCKER_DATABASE_URL=mysql://terminus:changethis@host.docker.internal:3308/terminus
